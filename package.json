{
  "name": "abb-tic-tac-toe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/src/server.ts\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch server/src/server.ts",
    "build": "tsc -b && vite build",
    "build:backend": "tsc -p server/tsconfig.json",
    "start": "vite",
    "start:backend": "node server/dist/server.js",
    "test": "jest --runInBand",
    "test:backend": "vitest run --config server/vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern dist --ignore-pattern server/dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
